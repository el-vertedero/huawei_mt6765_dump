	fragment@20 {
		target = <0xffffffff>;

		__overlay__ {

			fingerprint_spi_default {
				phandle = <0x12>;
			};

			fingerprint_spi_cs_low {
				phandle = <0x13>;

				pins_cmd_dat {
					pinmux = <0x9c01>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			fingerprint_spi_cs_high {
				phandle = <0x14>;

				pins_cmd_dat {
					pinmux = <0x9c01>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			fingerprint_spi_miso_low {
				phandle = <0x15>;

				pins_cmd_dat {
					pinmux = <0x9b01>;
					slew-rate = <0x00>;
					bias-pull-up = <0x00>;
				};
			};

			fingerprint_spi_miso_high {
				phandle = <0x16>;

				pins_cmd_dat {
					pinmux = <0x9b01>;
					bias-disable;
				};
			};

			fingerprint_spi_mosi_low {
				phandle = <0x17>;

				pins_cmd_dat {
					pinmux = <0x9d01>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			fingerprint_spi_mosi_high {
				phandle = <0x18>;

				pins_cmd_dat {
					pinmux = <0x9d01>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			fingerprint_spi_mclk_low {
				phandle = <0x19>;

				pins_cmd_dat {
					pinmux = <0x9e01>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			fingerprint_spi_mclk_high {
				phandle = <0x1a>;

				pins_cmd_dat {
					pinmux = <0x9e01>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			fingerprint_rst_low {
				phandle = <0x1b>;

				pins_cmd_dat {
					pinmux = <0xab00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			fingerprint_rst_high {
				phandle = <0x1c>;

				pins_cmd_dat {
					pinmux = <0xab00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			fingerprint_power_low {
				phandle = <0x1d>;
			};

			fingerprint_power_high {
				phandle = <0x1e>;
			};

			fingerprint_eint_as_int {
				phandle = <0x1f>;

				pins_cmd_dat {
					pinmux = <0x500>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			fingerprint_eint_in_low {
				phandle = <0x20>;

				pins_cmd_dat {
					pinmux = <0x500>;
					slew-rate = <0x00>;
					bias-pull-down = <0x00>;
				};
			};

			fingerprint_eint_in_float {
				phandle = <0x21>;

				pins_cmd_dat {
					pinmux = <0x500>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};
		};
	};


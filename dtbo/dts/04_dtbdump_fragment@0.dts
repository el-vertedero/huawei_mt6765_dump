/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "huawei,dev_detect";
			touch_panel = <0x00>;
			compass = <0x00>;
			g_sensor = <0x00>;
			camera_main = <0x00>;
			camera_slave = <0x00>;
			keypad = <0x00>;
			aps = <0x00>;
			gyroscope = <0x00>;
			nfc = <0x00>;
			dc_dc = <0x00>;
			speaker = <0x00>;
			ofn = <0x00>;
			tps = <0x00>;
			l_sensor = <0x00>;
			charge = <0x00>;
			battery = <0x00>;
			nct = <0x00>;
			mhl = <0x00>;
			audience = <0x00>;
			irda = <0x00>;
			hand_sensor = <0x00>;
			usb_switch = <0x00>;
			pmu_dcdc = <0x00>;
			camera_pmu = <0x00>;
			fm = <0x00>;
			wifi = <0x00>;
			bt = <0x00>;
			gps = <0x00>;
			gpu = <0x00>;
			cpu_chip = <0x00>;
			antenna_ctl = <0x00>;
			airpress = <0x00>;
			handpress = <0x00>;
			vibrator_lra = <0x00>;
			laser = <0x00>;
			camera_pmic = <0x00>;
			typec = <0x00>;
			anc_max14744 = <0x00>;
			charge_loadswitch = <0x00>;
			max77813 = <0x00>;
			coul = <0x00>;
			dtv = <0x00>;
			ap_color = <0x00>;
			status = "ok";
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "default\0state_id0_default\0state_id0_bias_up\0state_id0_bias_down\0state_id1_default\0state_id1_bias_up\0state_id1_bias_down\0state_id2_default\0state_id2_bias_up\0state_id2_bias_down";
			pinctrl-0 = <0x01>;
			pinctrl-1 = <0x02>;
			pinctrl-2 = <0x03>;
			pinctrl-3 = <0x04>;
			pinctrl-4 = <0x05>;
			pinctrl-5 = <0x06>;
			pinctrl-6 = <0x07>;
			pinctrl-7 = <0x08>;
			pinctrl-8 = <0x09>;
			pinctrl-9 = <0x0a>;
			status = "ok";
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {

			ant_pins_all_default {
				phandle = <0x01>;
			};

			ant_pins_id0_default {
				phandle = <0x02>;

				pins_cmd_dat {
					pinmux = <0xb000>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			ant_pins_id0_bias_up {
				phandle = <0x03>;

				pins_cmd_dat {
					pinmux = <0xb000>;
					slew-rate = <0x00>;
					bias-pull-up;
				};
			};

			ant_pins_id0_bias_down {
				phandle = <0x04>;

				pins_cmd_dat {
					pinmux = <0xb000>;
					slew-rate = <0x00>;
					bias-pull-down;
				};
			};

			ant_pins_id1_default {
				phandle = <0x05>;

				pins_cmd_dat {
					pinmux = <0xaf00>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			ant_pins_id1_bias_up {
				phandle = <0x06>;

				pins_cmd_dat {
					pinmux = <0xaf00>;
					slew-rate = <0x00>;
					bias-pull-up;
				};
			};

			ant_pins_id1_bias_down {
				phandle = <0x07>;

				pins_cmd_dat {
					pinmux = <0xaf00>;
					slew-rate = <0x00>;
					bias-pull-down;
				};
			};

			ant_pins_id2_default {
				phandle = <0x08>;

				pins_cmd_dat {
					pinmux = <0xac00>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			ant_pins_id2_bias_up {
				phandle = <0x09>;

				pins_cmd_dat {
					pinmux = <0xac00>;
					slew-rate = <0x00>;
					bias-pull-up;
				};
			};

			ant_pins_id2_bias_down {
				phandle = <0x0a>;

				pins_cmd_dat {
					pinmux = <0xac00>;
					slew-rate = <0x00>;
					bias-pull-down;
				};
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			pinctrl-names = "default\0idle";
			pinctrl-0 = <0x0b>;
			pinctrl-1 = <0x0c>;
			gpio_count = <0x01>;
			debounce-interval = <0x0f>;
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			ant_cable_det_default {
				phandle = <0x0b>;

				pins_cmd_dat {
					pinmux = <0x200>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			ant_cable_det_idle {
				phandle = <0x0c>;

				pins_cmd_dat {
					pinmux = <0x200>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			led@0 {
				compatible = "mediatek,red";
				max_brightness = <0x02>;
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x4e>;
			};

			led@1 {
				compatible = "mediatek,green";
				max_brightness = <0x02>;
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x4f>;
			};

			led@2 {
				compatible = "mediatek,blue";
				max_brightness = <0x02>;
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x50>;
			};

			led@3 {
				compatible = "mediatek,jogball-backlight";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x51>;
			};

			led@4 {
				compatible = "mediatek,keyboard-backlight";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x52>;
			};

			led@5 {
				compatible = "mediatek,button-backlight";
				led_mode = <0x00>;
				data = <0x01>;
				pwm_config = <0x00 0x00 0x00 0x00 0x00>;
				phandle = <0x53>;
			};

			led@6 {
				compatible = "mediatek,lcd-backlight";
				led_mode = <0x05>;
				data = <0x01>;
				pwm_config = <0x00 0x03 0x00 0x00 0x00>;
				phandle = <0x54>;
			};

			vibrator@0 {
				compatible = "mediatek,vibrator";
				vib_timer = <0x19>;
				vib_limit = <0x09>;
				vib_vol = <0x0b>;
				vib_vol_cal = <0x0a>;
				phandle = <0x55>;
			};
		};
	};

	fragment@6 {
		target = <0xffffffff>;

		__overlay__ {

			bled {
				mt,max_bled_brightness = <0x555>;
			};

			dsv {
				db_vbst_del;
				db_delay_del;
			};
		};
	};

	fragment@7 {
		target = <0xffffffff>;

		__overlay__ {

			eint0default {
				phandle = <0x56>;
			};

			eint@0 {
				phandle = <0x11>;

				pins_cmd_dat {
					pinmux = <0x00>;
					slew-rate = <0x00>;
					bias-disable;
				};
			};

			eintoutput0 {
				phandle = <0x57>;

				pins_cmd_dat {
					pinmux = <0x00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			eintoutput1 {
				phandle = <0x58>;

				pins_cmd_dat {
					pinmux = <0x00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			rstoutput0 {
				phandle = <0x0f>;

				pins_cmd_dat {
					pinmux = <0xae00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			rstoutput1 {
				phandle = <0x0d>;

				pins_cmd_dat {
					pinmux = <0xae00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			csoutput0 {
				phandle = <0x10>;

				pins_cmd_dat {
					pinmux = <0x1a01>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			csoutput1 {
				phandle = <0x0e>;

				pins_cmd_dat {
					pinmux = <0x1a01>;
					slew-rate = <0x01>;
					output-high;
				};
			};
		};
	};

	fragment@8 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";

			huawei_thp@10 {
				compatible = "huawei,thp";
				spi-max-frequency = <0x989680>;
				spi-bus-id = <0x01>;
				reg = <0x00>;
				pl022,com-mode = <0x02>;
				pl022,interface = <0x00>;
				pl022,rx-level-trig = <0x03>;
				pl022,tx-level-trig = <0x03>;
				pl022,ctrl-len = <0x07>;
				pl022,wait-state = <0x00>;
				pl022,duplex = <0x00>;
				pl022,slave-tx-disable = <0x00>;
				irq_flag = <0x02>;
				has_virtualkey = <0x00>;
				debounce = <0x06 0x00>;
				interrupt-parent = <0xffffffff>;
				interrupts = <0x00 0x02 0x00 0x00>;
				boot_reset_hi_delay_ms = <0x01>;
				boot_reset_low_delay_ms = <0x00>;
				boot_reset_after_delay_ms = <0x00>;
				resume_reset_after_delay_ms = <0x03>;
				suspend_reset_after_delay_ms = <0x00>;
				spi_sync_cs_hi_delay_ns = <0xc8>;
				spi_sync_cs_low_delay_ns = <0x0a>;
				pt_station_test = <0x01>;
				proximity_support = <0x00>;
				support_pinctrl = <0x01>;
				pinctrl-names = "default\0idle\0state_eint_as_int\0state_rst_output0\0state_rst_output1\0state_cs_output0\0state_cs_output1";
				pinctrl-0 = <0x0d 0x0e>;
				pinctrl-1 = <0x0f 0x10>;
				pinctrl-2 = <0x11>;
				pinctrl-3 = <0x0f>;
				pinctrl-4 = <0x0d>;
				pinctrl-5 = <0x10>;
				pinctrl-6 = <0x0e>;
				phandle = <0x59>;

				thp_input_dev {
					compatible = "huawei,thp_input";
					abs_max_x = <0x2d0>;
					abs_max_y = <0x640>;
				};

				novatech {
					spi_sync_cs_hi_delay_ns = <0xc8>;
					spi_sync_cs_low_delay_ns = <0x14>;
				};

				ilitek {
					boot_reset_hi_delay_ms = <0x05>;
					boot_reset_low_delay_ms = <0x05>;
				};
			};
		};
	};

	fragment@9 {
		target = <0xffffffff>;

		__overlay__ {

			rt9471@53 {
				compatible = "richtek,rt9471";
				status = "okay";
				reg = <0x53>;
				rt,intr_gpio = <0xffffffff 0x0b 0x00>;
				rt,ceb_gpio = <0xffffffff 0x9a 0x00>;
				charger_name = "rt9471";
				rm-slave-addr = [53];
				rm-name = "rt9471";
				interrupt-names = "wdt\0vac_ov\0otg_fault";
				ichg = <0x3e8>;
				aicr = <0x1f4>;
				mivr = <0x1130>;
				cv = <0x1130>;
				ieoc = <0x96>;
				safe-tmr = <0x14>;
				wdt = <0x28>;
				mivr-track = <0x00>;
				en-safe-tmr;
				en-te;
				en-qon-rst;
			};

			sgm41511h@6b {
				compatible = "huawei,sgm41511h_charger";
				status = "okay";
				reg = <0x6b>;
				gpio_int = <0xffffffff 0x0b 0x00>;
				gpio_cd = <0xffffffff 0x9a 0x00>;
			};
		};
	};

	fragment@10 {
		target = <0xffffffff>;

		__overlay__ {
			ac_charger_current = <0x291f58>;
			ac_charger_input_current = <0x231860>;
			non_std_ac_charger_current = <0x124f80>;
			dpm_enable;
			dynamic_cv_en;
			battery_cv = <0x434a90>;
			iterm = <0x249f0>;
			jeita_temp_t2_to_t3_cv = <0x434a90>;
			jeita_temp_t1_to_t2_cv = <0x434a90>;
			jeita_temp_t0_to_t1_cv = <0x434a90>;
			jeita_temp_t2_to_t3_cur = <0x291f58>;
			vdpm_buf_limit = <0x64>;
			vdpm_para = "-32767\04000\04300\050\04000\04200\04500\050\04200\032767\04600\050";
		};
	};

	fragment@11 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "huawei,charger";
			status = "okay";
		};
	};

	fragment@12 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "huawei,battery";
			voltage_max_design = <0x434a90>;
			status = "okay";
		};
	};

	fragment@13 {
		target = <0xffffffff>;

		__overlay__ {
			ac_charger_current = <0x100590>;
			ac_charger_input_current = <0x100590>;
			non_std_ac_charger_current = <0x100590>;
			is_power_path;
		};
	};

	fragment@14 {
		target = <0xffffffff>;

		__overlay__ {

			charger {
				status = "disabled";
			};
		};
	};

	fragment@15 {
		target = <0xffffffff>;

		__overlay__ {
			interrupt-parent = <0xffffffff>;
			interrupts = <0x29 0x08 0x29 0x00>;
			status = "okay";
		};
	};

	fragment@16 {
		target = <0xffffffff>;

		__overlay__ {
			bat_para = "DeasyCoslight_137\0130000\0220000\0ScudAtl\0250000\0350000\0NvtAtl\0400000\0510000\0DeasyCoslight_147\0590000\0690000\0SwdByd\0830000\0960000";
